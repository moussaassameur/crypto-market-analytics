# Configuration pour les tests d'intégration
NODE_ENV=test

# Base de données de test (utilise la même DB Docker mais peut être changée)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=crypto_platform
DB_USER=postgres
DB_PASSWORD=postgres

# JWT pour les tests
JWT_SECRET=test_jwt_secret_for_integration_tests
JWT_EXPIRES_IN=1d

# Port API (non utilisé par Supertest directement)
PORT=3001
