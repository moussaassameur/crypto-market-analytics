{
  "name": "api",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --testMatch='**/tests/**/*.test.js'",
    "test:unit": "jest tests/unit",
    "test:watch": "jest --watch",
    "test:integration": "set NODE_ENV=test&& jest tests/integration --runInBand --forceExit",
    "test:coverage": "jest tests/unit --coverage --coverageReporters=lcovonly",
    "coverage": "jest tests/unit --coverage --silent --coverageReporters=text-summary",
    "sonar": "sonar-scanner",
    "test:all": "npm run test:integration && npm test",
    "ci:test": "set NODE_ENV=test&& jest --runInBand --forceExit --coverage",
    "ci:test:integration": "set NODE_ENV=test&& jest tests/integration --runInBand --forceExit",
    "k6:smoke": "k6 run tests/k6/smoke-test.js",
    "k6:load": "k6 run tests/k6/load-test.js",
    "k6:stress": "k6 run tests/k6/stress-test.js",
    "k6:spike": "k6 run tests/k6/spike-test.js",
    "k6:all": "npm run k6:smoke && npm run k6:load && npm run k6:stress && npm run k6:spike",
    "security:snyk": "npx snyk test",
    "security:code": "npx snyk code test",
    "security:all": "npm run security:snyk && npm run security:code",
    "db:init": "psql -h localhost -p 5432 -U postgres -d crypto_platform -f scripts/init-database.sql",
    "db:init:test": "set NODE_ENV=test&& psql -h localhost -p 5433 -U postgres -d crypto_test -f scripts/init-database.sql"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.17.1",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "snyk": "^1.1301.2",
    "supertest": "^7.1.4"
  }
}
